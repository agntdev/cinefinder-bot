[
  {
    "name": "Recommendations show mood choices",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Pick the kind of movie you're in the mood for."
            }
          }
        ],
        "send": {
          "callback": "recommend:start"
        }
      }
    ]
  }
  ,{
    "name": "Custom recommendation validates input",
    "steps": [
      { "send": { "callback": "recommend:custom" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "!" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Use a short mood or genre made of letters and numbers, then try again." } }] }
    ]
  }
]
