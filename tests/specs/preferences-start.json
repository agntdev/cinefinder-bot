[
  {
    "name": "Preferences show a useful empty state",
    "steps": [
      {
        "expect": [
          {
            "method": "sendMessage",
            "payload": {
              "text": "Your movie preferences\n\nFavorite genres: none yet\nFavorite moods: none yet\nTrending alerts: off"
            }
          }
        ],
        "send": {
          "callback": "preferences:start"
        }
      }
    ]
  }
  ,{
    "name": "Preferences save a genre",
    "steps": [
      { "send": { "callback": "preferences:genre" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "text": "Mystery" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Saved Mystery to your favorite genres." } }] }
    ]
  }
]
